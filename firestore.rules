rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == "itamartrairi@gmail.com");
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /system_health/{id} {
      allow read, write: if true;
    }
    match /test/{id} {
      allow read, write: if true;
    }
    match /empresas/{empresaId} {
      allow read, write: if isAuthenticated();
    }
    match /areas/{areaId} {
      allow read, write: if isAuthenticated();
    }
    match /segmentos/{segmentoId} {
      allow read, write: if isAuthenticated();
    }
    match /problemas/{problemaId} {
      allow read, write: if isAuthenticated();
    }
    match /premissas/{premissaId} {
      allow read, write: if isAuthenticated();
    }
    match /diagnosticos/{diagnosticoId} {
      allow read, write: if isAuthenticated();
    }
    match /respostas/{respostaId} {
      allow read, write: if isAuthenticated();
    }
    match /solucoes/{solucaoId} {
      allow read, write: if isAuthenticated();
    }
    match /empresas_credenciadas/{credId} {
      allow read, write: if isAuthenticated();
    }
    match /tarefas_plano/{tarefaId} {
      allow read, write: if isAuthenticated();
    }
    match /agenda_eventos/{eventoId} {
      allow read, write: if isAuthenticated();
    }
    match /disc_avaliacoes/{id} {
      allow read, write: if isAuthenticated();
    }
    match /maturidade_avaliacoes/{id} {
      allow read, write: if isAuthenticated();
    }
    match /custom_modelos_relatorio/{id} {
      allow read, write: if isAuthenticated();
    }
    match /evidencias/{id} {
      allow read, write: if isAuthenticated();
    }
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
