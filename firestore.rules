rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email in ['itamartrairi@gmail.com', 'ithamar1307@gmail.com'];
    }
    function owns() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function createsOwn() { return signedIn() && request.resource.data.ownerId == request.auth.uid; }
    function credExists(credId) { return exists(/databases/$(database)/documents/empresas_credenciadas/$(credId)); }
    function credData(credId) { return get(/databases/$(database)/documents/empresas_credenciadas/$(credId)).data; }
    function managesCred(credId) {
      return signedIn() && credExists(credId) &&
        (isAdmin() || credData(credId).ownerId == request.auth.uid);
    }
    function isInvitedToCred(credId) {
      return signedIn() && credExists(credId) && request.auth.token.email != null &&
        request.auth.token.email.lower() in credData(credId).get('consultoresEmails', []);
    }
    function canReadWork() {
      return isAdmin() || owns() ||
        (resource.data.get('credenciadaId', '') != '' && managesCred(resource.data.credenciadaId)) ||
        (resource.data.get('credenciadaId', '') != '' && isInvitedToCred(resource.data.credenciadaId) && owns());
    }
    function canCreateWork() {
      return createsOwn() && (request.resource.data.get('credenciadaId', '') == '' ||
        managesCred(request.resource.data.credenciadaId) || isInvitedToCred(request.resource.data.credenciadaId));
    }
    function canUpdateWork() {
      return owns() && request.resource.data.ownerId == resource.data.ownerId &&
        (resource.data.get('credenciadaId', '') == '' || managesCred(resource.data.credenciadaId) || isInvitedToCred(resource.data.credenciadaId));
    }
    function isWorkCollection(col) {
      return col in ['empresas','diagnosticos','respostas','tarefas_plano','agenda_eventos',
        'disc_avaliacoes','maturidade_avaliacoes','analises_resultado'];
    }
    match /{col}/{docId} {
      allow read: if isWorkCollection(col) && canReadWork();
      allow create: if isWorkCollection(col) && canCreateWork();
      allow update: if isWorkCollection(col) && canUpdateWork();
      allow delete: if isWorkCollection(col) && (isAdmin() || owns() ||
        (resource.data.get('credenciadaId', '') != '' && managesCred(resource.data.credenciadaId)));
    }
    function licenseFields() {
      return ['status','tipoPlano','diasTeste','validadeLicenca','role','dataCadastro',
        'kiwifyOrderId','dataAtivacaoKiwify','dataCancelamentoKiwify'];
    }
    function isCredOwner() {
      return signedIn() && (resource.data.get('ownerId', '') == request.auth.uid ||
        (request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email));
    }
    function keepsCredOwner() {
      return request.resource.data.ownerId == request.auth.uid &&
        (resource.data.get('ownerId', '') == request.auth.uid ||
          (request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email));
    }
    function isOwnLicenseRecord() {
      return ('providerId' in resource.data) ||
        (request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email);
    }
    match /empresas_credenciadas/{credId} {
      allow read: if isAdmin() || resource == null || isCredOwner() ||
        (signedIn() && request.auth.token.email != null &&
          request.auth.token.email.lower() in resource.data.get('consultoresEmails', []));
      allow create: if isAdmin() || (createsOwn() &&
        request.resource.data.get('tipoPlano','Teste') == 'Teste' &&
        request.resource.data.get('role','cliente') != 'admin' &&
        request.resource.data.get('status','Ativa') == 'Ativa' &&
        request.resource.data.get('diasTeste',30) <= 30 &&
        request.resource.data.get('dataCadastro',null) == request.time &&
        !('validadeLicenca' in request.resource.data));
      allow update: if isAdmin() || (isCredOwner() && keepsCredOwner() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(licenseFields()));
      allow delete: if isAdmin() || (owns() && !isOwnLicenseRecord());
    }
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId && !('role' in request.resource.data));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }
    match /{col}/{docId} {
      allow read: if col in ['premissas','problemas','solucoes','areas','segmentos'] && (isAdmin() || owns());
      allow create: if col in ['premissas','problemas','solucoes','areas','segmentos'] && (isAdmin() || createsOwn());
      allow update: if col in ['premissas','problemas','solucoes','areas','segmentos'] &&
        (isAdmin() || (owns() && request.resource.data.ownerId == resource.data.ownerId));
      allow delete: if col in ['premissas','problemas','solucoes','areas','segmentos'] && (isAdmin() || owns());
    }
    match /system_health/connection_probe { allow read, write: if signedIn(); }
    match /test/connection { allow read: if signedIn(); }
  }
}
