rules_version = '2';

// =====================================================================================
//  Consultor Pro — Regras do Firestore
//  Cada consultor só enxerga e altera os PRÓPRIOS dados (campo ownerId = uid do login).
//  Consultores cadastrados numa credenciada (consultores_acesso) trabalham nos dados do
//  dono dessa credenciada.
//  O app filtra todas as consultas por ownerId (src/lib/firestoreOwned.ts) e preenche
//  ownerId em toda gravação, então estas regras não bloqueiam o uso normal.
//
//  Publicar: Console do Firebase → Firestore Database → (banco do app) → Regras → Publicar.
// =====================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin é definido apenas pelo e-mail verificado do login.
    // (O app e o servidor usam itamartrairi@gmail.com; as regras só tinham ithamar1307.)
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email in ["itamartrairi@gmail.com", "ithamar1307@gmail.com"] &&
        request.auth.token.email_verified == true;
    }

    // --- Consultores de credenciada ----------------------------------------------------
    // Um consultor cadastrado na credenciada (com e-mail Google) tem um documento em
    // consultores_acesso/{email}. Enquanto estiver ativo, ele trabalha nos dados do dono
    // da credenciada (mesmo ownerId).
    function loginEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }
    function acessoPath() {
      return /databases/$(database)/documents/consultores_acesso/$(loginEmail());
    }
    function isConsultorAtivo() {
      return isAuthenticated() && loginEmail() != '' &&
        request.auth.token.email_verified == true &&
        exists(acessoPath()) && get(acessoPath()).data.ativo == true;
    }
    function workspaceOwner() {
      return get(acessoPath()).data.ownerId;
    }
    // uid é o próprio usuário ou o dono da credenciada do consultor logado.
    function isWorkspace(uid) {
      return isAuthenticated() &&
        (uid == request.auth.uid || (isConsultorAtivo() && uid == workspaceOwner()));
    }

    // --- Dono do documento ---------------------------------------------------------
    function ownsExisting() {
      return isWorkspace(resource.data.ownerId);
    }
    function createsOwn() {
      return isWorkspace(request.resource.data.ownerId);
    }
    function keepsOwner() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }
    // Somente o próprio usuário (sem considerar consultores).
    function ownsExistingSelf() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
    function createsOwnSelf() {
      return isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }
    function keepsOwnerSelf() {
      return request.resource.data.ownerId == request.auth.uid;
    }

    // Coleções isoladas por usuário (dados de trabalho e biblioteca de cada consultor).
    function isOwnedCollection(col) {
      return col in [
        'empresas', 'diagnosticos', 'respostas', 'tarefas_plano',
        'agenda_eventos', 'disc_avaliacoes', 'maturidade_avaliacoes', 'analises_resultado',
        'premissas', 'problemas', 'solucoes', 'areas', 'segmentos'
      ];
    }

    match /{col}/{docId} {
      // resource == null: leitura/exclusão de um documento que não existe (não vaza nada).
      allow read:   if isOwnedCollection(col) && (resource == null || ownsExisting());
      allow create: if isOwnedCollection(col) && createsOwn();
      allow update: if isOwnedCollection(col) && ownsExisting() && keepsOwner();
      allow delete: if isOwnedCollection(col) && (resource == null || ownsExisting());
    }

    // --- Licenças -------------------------------------------------------------------
    // O consultor lê e edita o próprio cadastro, mas não altera status, plano, dias de
    // teste ou validade — isso é feito pelo admin ou pelo webhook da Kiwify (Firebase
    // Admin SDK, que não passa por estas regras).
    function licenseFields() {
      return ['status', 'tipoPlano', 'diasTeste', 'validadeLicenca', 'role', 'dataCadastro',
              'kiwifyOrderId', 'dataAtivacaoKiwify', 'dataCancelamentoKiwify'];
    }
    function isCredOwner() {
      return isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid ||
         (request.auth.token.email != null && resource.data.email == request.auth.token.email));
    }

    // Cadastro de LICENÇA do próprio consultor (criado no primeiro login): tem providerId
    // ou o mesmo e-mail do login. Os demais documentos são empresas que ele cadastrou.
    function isOwnLicenseRecord() {
      return ('providerId' in resource.data) ||
        (request.auth.token.email != null && resource.data.get('email', '') == request.auth.token.email);
    }

    match /empresas_credenciadas/{credId} {
      // Consultores leem as credenciadas do dono (dados para relatórios e licença).
      allow read: if isAdmin() || resource == null || isCredOwner() || ownsExisting();
      // Só o administrador cadastra credenciadas. Os demais usuários só criam o próprio
      // cadastro de licença no primeiro login (tem providerId) — uma credenciada por usuário.
      allow create: if isAdmin() ||
        (createsOwnSelf() &&
         ('providerId' in request.resource.data) &&
         request.resource.data.get('tipoPlano', 'Teste') == 'Teste' &&
         request.resource.data.get('role', 'cliente') != 'admin' &&
         request.resource.data.get('status', 'Ativa') == 'Ativa' &&
         request.resource.data.get('diasTeste', 30) <= 30 &&
         // A data de cadastro tem que ser a hora do servidor (serverTimestamp): sem isso dava
         // para criar o cadastro com data no futuro e o teste quase não diminuía.
         request.resource.data.get('dataCadastro', null) == request.time &&
         !('validadeLicenca' in request.resource.data));
      // O dono edita o cadastro (inclusive a lista de consultores), mas não os campos de
      // licença. Consultores não alteram a credenciada.
      allow update: if isAdmin() ||
        (isCredOwner() && keepsOwnerSelf() &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(licenseFields()));
      // O consultor pode excluir empresas que cadastrou, mas NÃO o próprio cadastro de
      // licença: apagá-lo fazia o app criar um novo com mais 30 dias de teste no próximo
      // login (e desbloqueava quem estava bloqueado ou vencido).
      allow delete: if isAdmin() || resource == null || (ownsExistingSelf() && !isOwnLicenseRecord());
    }

    // --- Acesso de consultores ----------------------------------------------------------
    // Documento id = e-mail (minúsculo) do consultor. Gravado pelo dono da credenciada
    // (ownerId tem que ser o dono atual da credenciada indicada) ou pelo admin.
    function credenciadaDono(credId) {
      return get(/databases/$(database)/documents/empresas_credenciadas/$(credId)).data.ownerId;
    }
    function gravaAcessoValido(consultorId) {
      return request.resource.data.keys().hasAll(['ownerId', 'credenciadaId', 'ativo', 'email']) &&
        request.resource.data.email == consultorId &&
        request.resource.data.ativo is bool &&
        exists(/databases/$(database)/documents/empresas_credenciadas/$(request.resource.data.credenciadaId)) &&
        request.resource.data.ownerId == credenciadaDono(request.resource.data.credenciadaId) &&
        (isAdmin() || request.resource.data.ownerId == request.auth.uid);
    }
    match /consultores_acesso/{consultorId} {
      allow read: if isAdmin() || resource == null ||
        (isAuthenticated() && (resource.data.ownerId == request.auth.uid || consultorId == loginEmail()));
      allow create: if isAuthenticated() && gravaAcessoValido(consultorId);
      // Atualiza: quem já controla o acesso, ou o novo dono da mesma credenciada.
      allow update: if isAuthenticated() && gravaAcessoValido(consultorId) &&
        (isAdmin() || resource.data.ownerId == request.auth.uid ||
         resource.data.credenciadaId == request.resource.data.credenciadaId);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    // --- Perfil de usuário ------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == userId && !('role' in request.resource.data));
      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // --- Teste de conexão do app ------------------------------------------------------
    match /system_health/connection_probe {
      allow read, write: if isAuthenticated();
    }
    match /test/connection {
      allow read: if isAuthenticated();
    }

    // Qualquer outra coleção fica fechada.
  }
}
